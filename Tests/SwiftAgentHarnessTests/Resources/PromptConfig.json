{
  "options": {
    "includeCurrentDateTime": false,
    "includeAgentSkills": false
  },
  "settings": {
    "skillsFolderPath": "/skills",
    "modelPoolProviderPreference": {
      "order": ["anthropic", "openai", "ollama", "lmstudio", "openrouter"]
    }
  },
  "agentHarness": {
    "strictAgentHarnessPrompts": true
  },
  "toolPolicy": {
    "elevated": {
      "perCall": ["bash"]
    },
    "requireApproval": [
      "enter_plan_mode",
      "exit_plan_mode"
    ]
  },
  "subAgentHostingPolicy": {
    "entries": {
      "Coding Agent": {
        "hostPersonaID": "coding-agent",
        "routingDomain": "engineering",
        "tenantScope": "default",
        "authScopeTags": ["repo:write"],
        "delegationAllowlist": []
      }
    }
  },
  "modeProfiles": [
    {
      "id": "plan",
      "interactionMode": "plan",
      "assemblyKind": "planCollaboration",
      "tools": {
        "allow": [
          "create_plan",
          "edit_plan",
          "add_plan_task",
          "delete_plan_task",
          "get_plan",
          "exit_plan_mode",
          "ask_user",
          "think",
          "finish",
          "read_file",
          "read_attachment",
          "glob",
          "grep"
        ],
        "deny": [
          "bash",
          "write_file",
          "edit_file",
          "process",
          "process_send_keys",
          "spawn_sub_agent",
          "Coding Agent"
        ]
      },
      "subAgents": {
        "allow": [],
        "maxDepth": 0
      }
    },
    {
      "id": "agent",
      "interactionMode": "agent",
      "assemblyKind": "agentBuild",
      "tools": {
        "allow": [
          "add_plan_note",
          "update_plan_task",
          "get_plan",
          "enter_plan_mode",
          "declare_agent_build_complete",
          "ask_user",
          "think",
          "finish",
          "Coding Agent",
          "bash",
          "read_file",
          "write_file",
          "edit_file",
          "glob",
          "grep",
          "process",
          "process_send_keys",
          "XcodeLS",
          "XcodeMV",
          "XcodeRM",
          "XcodeGrep",
          "XcodeUpdate",
          "RenderPreview",
          "GetBuildLog",
          "RunSomeTests",
          "DocumentationSearch",
          "BuildProject",
          "XcodeMakeDir",
          "XcodeWrite",
          "XcodeGlob",
          "XcodeListNavigatorIssues",
          "ExecuteSnippet",
          "XcodeRefreshCodeIssuesInFile",
          "RunAllTests",
          "XcodeRead",
          "GetTestList"
        ],
        "deny": [
          "create_plan",
          "edit_plan",
          "add_plan_task",
          "delete_plan_task",
          "exit_plan_mode"
        ]
      },
      "runtime": {
        "termination": {
          "recovery": {
            "maxAttempts": 10,
            "behavioralInjectAfterStalls": 2,
            "behavioralRecoveryTemperature": 0.2
          }
        }
      }
    },
    {
      "id": "trigger-host",
      "interactionMode": "chat",
      "assemblyKind": "chat",
      "tools": {
        "allow": []
      },
      "skills": {
        "allow": []
      },
      "subAgents": {
        "allow": "*",
        "maxDepth": 1
      }
    }
  ],
  "memory": {
    "activeMemoryEnabled": true,
    "activeMemoryStandingEnabled": true,
    "activeMemorySituationalEnabled": true
  }
}
