{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swiftagentharness.dev/schemas/ws/client-surface-intent-wire.json",
  "title": "ClientSurfaceIntent",
  "description": "Structured client surface action (`semanticKind == surfaceIntent`).",
  "type": "object",
  "required": ["kind", "filePath"],
  "properties": {
    "v": { "type": "integer", "minimum": 1 },
    "kind": {
      "type": "string",
      "enum": [
        "openFileForEdit", "execApprovalRequired", "execApprovalCleared",
        "computerUseRequest", "computerUseRequestCleared", "computerUseActivity"
      ]
    },
    "filePath": { "type": "string" },
    "scope": { "type": "string" },
    "label": { "type": "string" },
    "approvalID": { "type": "string" },
    "command": { "type": "string" },
    "presentation": { "$ref": "approval-presentation.schema.json" },
    "computerUse": {
      "type": "object",
      "description": "Present on the computerUse* kinds.",
      "properties": {
        "requestID": { "type": "string" },
        "requestKind": { "type": "string", "enum": ["question", "handoff"] },
        "prompt": { "type": "string" },
        "reason": { "type": "string" },
        "target": { "type": "string" },
        "lifecycleID": { "type": "string" },
        "status": { "type": "string", "enum": ["started", "acting", "taken-over", "ended"] },
        "step": { "type": "integer", "minimum": 0 },
        "maxSteps": { "type": "integer", "minimum": 0 },
        "app": { "type": "string" },
        "action": { "type": "string" },
        "terminalReason": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
